# Copy to .env in the repo root and fill in. .env is ignored by git; never force-add it.

# Alerts (Resend). Create a key at resend.com.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Optional: a free USGS Water Data API key raises the rate limit (docs/sources.md §3).
API_USGS_PAT=

# Database file (relative to the repo root) and the second-disk folder for weekly copies.
ROLL_CALL_DB=data/roll_call.duckdb
BACKUP_DIR=/mnt/backup/roll-call

# Optional: the branch the dashboard data is committed and pushed to (default main).
PUBLISH_BRANCH=main
